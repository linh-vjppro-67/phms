# Mẫu cấu hình production – sao chép thành phms.env, ĐIỀN GIÁ TRỊ THẬT, phân quyền 0600, KHÔNG đưa vào git.
# Tạo khóa ngẫu nhiên:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PHMS_ENV=production
PHMS_SECRET=__DAT_CHUOI_NGAU_NHIEN_TOI_THIEU_32_KY_TU__
PHMS_DOC_KEY=__DAT_KHOA_RIENG_CHO_TAI_LIEU__
PHMS_DB_URL=postgresql+psycopg://phms:__MAT_KHAU_DB__@db:5432/phms
PHMS_DOC_DIR=/data/storage

# Số kết nối mỗi worker: (POOL + OVERFLOW) x số worker phải nhỏ hơn max_connections của PostgreSQL
PHMS_DB_POOL=10
PHMS_DB_OVERFLOW=10

# MFA bắt buộc theo vai trò (khuyến nghị tối thiểu sysadmin)
PHMS_MFA_REQUIRED_ROLES=sysadmin
PHMS_MFA_ISSUER=PHMS

# SSO OIDC (bỏ comment khi có IdP)
#PHMS_OIDC_ISSUER=https://idp.example.org/realms/phms
#PHMS_OIDC_CLIENT_ID=phms
#PHMS_OIDC_CLIENT_SECRET=__BI_MAT_CLIENT__
#PHMS_OIDC_REDIRECT_URI=https://phms.example.org/api/auth/sso/callback
#PHMS_OIDC_USER_CLAIM=preferred_username
#PHMS_PASSWORD_LOGIN_DISABLED=1

# Worker web không chạy lập lịch; chạy riêng bằng: python -m app.scheduler_cli --loop
PHMS_SCHEDULER=0
